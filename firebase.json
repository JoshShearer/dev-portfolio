{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*"],
    "redirects": [
      { "source": "/resume-page", "destination": "/resume", "type": 301 },
      { "source": "/projects-page", "destination": "/#work", "type": 301 },
      { "source": "/profile-page", "destination": "/", "type": 301 },
      { "source": "/landing-page", "destination": "/", "type": 301 },
      { "source": "/technical-page", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
